@* @model diveWebMVC.Models.TUproduct *@
@model diveWebMVC.ViewModels.TUproductsviewmodels
@{
    ViewData["Title"] = "Create";
}
@section Styles {
    <style>
        .container {
            width: 100%;
            max-width: none;
            padding: 40px; /* 增加內邊距 */
            margin: 0 40px; /* 增加左右外邊距 */
        }

    </style>
}
<div class="container">
    <div>
        <h1>新增商品</h1>
    </div>
    <hr />
    <div >
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="SellerId" class="control-label"></label>
                        <select asp-for="SellerId" class="form-control" asp-items="ViewBag.SellerId"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="CategoryId" class="control-label"></label>
                        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="ProductName" class="control-label"></label>
                        <input asp-for="ProductName" class="form-control" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ProductDescription" class="control-label"></label>
                        <input asp-for="ProductDescription" class="form-control" />
                        <span asp-validation-for="ProductDescription" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ProductPrice" class="control-label"></label>
                        <input asp-for="ProductPrice" class="form-control" />
                        <span asp-validation-for="ProductPrice" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UpdatedAt" class="control-label"></label>
                        <input asp-for="UpdatedAt" class="form-control" />
                        <span asp-validation-for="UpdatedAt" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CreatedAt" class="control-label"></label>
                        <input asp-for="CreatedAt" class="form-control" />
                        <span asp-validation-for="CreatedAt" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ProductConditionId" class="control-label"></label>
                        <select asp-for="ProductConditionId" class="form-control" asp-items="ViewBag.ProductConditionId"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="ProductStatus" class="control-label"></label>
                        <input asp-for="ProductStatus" class="form-control" />
                        <span asp-validation-for="ProductStatus" class="text-danger"></span>
                    </div>
                    @* <div class="form-group">
                        <label>選擇圖片</label>
                        <div class="col-6">
                            <h6 class="mb-4">選擇圖片</h6>
                            <div class="form-group mb-3">
                                <img id="imgPreview" class="img-fluid mb-3 image-preview" src='@Url.Content("~/images/err2.png")' title="尚無圖片" />
                                <input type="file" class="form-control" id="imageInput" name="Images" accept="image/*" />
                                <span asp-validation-for="Image" class="text-danger"></span>
                            </div>
                        </div>
                    </div> *@

                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
        <br />
        <div>
            <a asp-action="Index">返回上頁</a>
        </div>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
