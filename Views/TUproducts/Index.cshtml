@model IEnumerable<diveWebMVC.ViewModels.TUproductsviewmodels>

@{
    ViewData["Title"] = "Index";
}
@section Styles {
    <style>

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .container {
            width: 100%;
            max-width: none;
            padding: 40px; /* 增加內邊距 */
            margin: 0 40px; /* 增加左右外邊距 */
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            /* margin-left: 40px; /* 增加左側邊距 */
            /* margin-right: 40px; /* 增加右側邊距 */
        }

        th, td {
            padding: 5px;
            word-wrap: break-word;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: center; /* 表格頭與表格資料內容文字居中 */
            font-family: 'PMingLiU', '新細明體', sans-serif; /* 設置字體 */
            font-size: 16px;
            font-weight: bold;
        }

        .wide-column {
            width: 200px; /* 調整寬度 */
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .top-bar .searchBar {
                display: flex;
                gap: 10px;
         }

         .top-bar .searchBar .form-control {
                    width: 200px;
         }

        .topic {
            margin-bottom: 20px;
            text-align: center;
        }

        .top-bar .btn {
            font-size: 16px;
            padding: 10px 20px;
            /* 統一按鈕顏色 */
            color: #198754;
            border: 1px solid #198754;
            background-color: white;
            text-decoration: none;
        }

            .top-bar .btn:hover {
                background-color: #198754;
                color: white;
            }

        .product-image {
            max-width: 100%;
            height: auto;
            object-fit: cover;
        }

    </style>
}
<div class="container">
    <div>
        <h1>商品</h1>

    </div>
    <div class="top-bar">

        <a asp-action="Create" class="btn btn-outline-success" style=" text-decoration: none;">新增商品</a>
        

        <!-- 搜索表单 -->
        <form class="d-flex searchBar" method="get" role="search" asp-action="Index">
            <input id="searchString" class="form-control me-2" type="search" placeholder="搜尋商品名稱" name="searchString" aria-label="Search" value="@ViewBag.CurrentFilter" />
            <button class="btn btn-outline-success" type="submit">搜尋</button>
        </form>
    </div>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ProductName)
                </th>
                @* <th>
                    @Html.DisplayNameFor(model => model.Image)
                </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.ProductDescription)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductPrice)
                </th>
                <th class="wide-column">
                    @Html.DisplayNameFor(model => model.UpdatedAt)
                </th>
                <th class="wide-column">
                    @Html.DisplayNameFor(model => model.CreatedAt)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductStatus)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CategoryId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductCondition)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SellerId)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    @* <td>
                        <img src="@Url.Action("GetPicture", "TUproducts", new { id = item.ProductId })"
                             class="product-image"
                             onerror="this.onerror=null; this.src='@Url.Content("~/images/err2.png")';" />

                    </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductPrice)
                    </td>
                    <td class="wide-column">
                        @Html.DisplayFor(modelItem => item.UpdatedAt)
                    </td>
                    <td class="wide-column">
                        @Html.DisplayFor(modelItem => item.CreatedAt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductStatus)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CategoryId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductConditionId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SellerId)
                    </td>
                    <td>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.ProductId">編輯</a>
                        </div>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Details" asp-route-id="@item.ProductId">明細</a>
                        </div>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Delete" asp-route-id="@item.ProductId">刪除</a>
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let deleteId = null;

        // 設定刪除的商品 ID
        function setDeleteId(id) {
            deleteId = id;
            document.getElementById("deleteId").value = id;
        }

        // 確認刪除時觸發
        function confirmDelete() {
            document.getElementById("deleteForm").submit(); // 提交刪除表單
        }

        // 提交篩選表單
        function submitFilterForm() {
            document.getElementById("filterForm").submit();
        }
    </script>
}