@model IEnumerable<diveWebMVC.ViewModels.TUproductsviewmodels>

@{
    ViewData["Title"] = "Index";
}
@section Styles {
    <style>

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .container {
            width: 100%;
            max-width: none;
            padding: 40px; /* 增加內邊距 */
            margin: 0 40px; /* 增加左右外邊距 */
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            /* margin-left: 40px; /* 增加左側邊距 */
            /* margin-right: 40px; /* 增加右側邊距 */
        }

        th, td {
            padding: 5px;
            text-align: left;
            word-wrap: break-word;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: center; /* 表格頭與表格資料內容文字居中 */
            font-family: 'PMingLiU', '新細明體', sans-serif; /* 設置字體 */
            font-size: 16px;
            font-weight: bold;
        }

        .wide-column {
            width: 200px; /* 調整寬度 */
        }
    </style>
}
<div class="container">
    <div>
        <h1>商品</h1>


        <p>
            <a asp-action="Create" class="btn btn-success">新增商品</a>
        </p>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ProductName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductDescription)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductPrice)
                </th>
                <th class="wide-column">
                    @Html.DisplayNameFor(model => model.UpdatedAt)
                </th>
                <th class="wide-column">
                    @Html.DisplayNameFor(model => model.CreatedAt)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductStatus)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CategoryId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductCondition)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SellerId)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductPrice)
                    </td>
                    <td class="wide-column">
                        @Html.DisplayFor(modelItem => item.UpdatedAt)
                    </td>
                    <td class="wide-column">
                        @Html.DisplayFor(modelItem => item.CreatedAt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductStatus)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CategoryId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductConditionId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SellerId)
                    </td>
                    <td>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.ProductId">編輯</a>
                        </div>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Details" asp-route-id="@item.ProductId">明細</a>
                        </div>
                        <div class="mb-2">
                            <a class="btn btn-dark" asp-action="Delete" asp-route-id="@item.ProductId">刪除</a>
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>