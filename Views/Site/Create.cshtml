@model diveWebMVC.Models.TSsiteDetail

@{
    ViewData["Title"] = "Create";
}




<hr />
<div class="container">
    <h3>新增</h3>
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="VenueName" class="control-label"></label>
                <input asp-for="VenueName" class="form-control" />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfPeople" class="control-label"></label>
                <input asp-for="NumberOfPeople" class="form-control" />
                <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VenueAddress" class="control-label"></label>
                <input asp-for="VenueAddress" class="form-control" />
                <span asp-validation-for="VenueAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Detail" class="control-label"></label>
                <input asp-for="Detail" class="form-control" />
                <span asp-validation-for="Detail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="State" class="control-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
@*             <div class="form-group">
                <label asp-for="Photo" class="control-label"></label>

                <!-- 修改這裡 -->
                <input type="file" id="Photo" name="Photo" accept=".jpg,.jpeg,.png,.gif" class="form-control" /> <!-- <span style="color: red;">新增這行</span> -->

                <span asp-validation-for="Photo" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-danger">取消</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
