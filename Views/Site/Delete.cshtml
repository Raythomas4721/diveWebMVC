@model diveWebMVC.Models.TSsiteDetail

@{
    ViewData["Title"] = "Delete";
}
<div>
<h3>刪除訂單</h3>


</div>
<div class="container">
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SiteId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SiteId) <!-- 顯示 SiteId -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.VenueName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.VenueName) <!-- 顯示 VenueName -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NumberOfPeople)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NumberOfPeople) <!-- 顯示 NumberOfPeople -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.VenueAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.VenueAddress) <!-- 顯示 VenueAddress -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Detail)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Detail) <!-- 顯示 Detail -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.State)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.State) <!-- 顯示 State -->
        </dd>


    </dl>
    <h4>確定要刪除該筆資料嗎?</h4>
    <form asp-action="Delete">
        <input type="hidden" asp-for="SiteId" />
        <input type="submit" value="刪除" class="btn btn-danger" /> |
        <a asp-action="Index" button type="button" class="btn btn-primary">取消</a>
    </form>
</div>
