@model TMmemberList
@inject diveShopperContext _context
@{
	TMmemberList? member = await _context.TMmemberLists.FindAsync(Model.MemberId);
	if(member != null && member.MemberPhoto!=null) {
		<img class="img-fluid" style="width:320px;height:200px" src='@Url.Action("GetPicture","TMmemberLists",new {id = Model.MemberId})' title="@Model.MemberName" />
	}
	else {
		<img class="img-fluid" style="width:320px;height:200px" src='@Url.Content("~/images/NoPerson.png")' title="尚無圖片" />
	}
}