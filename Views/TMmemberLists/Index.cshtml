@model IEnumerable<diveWebMVC.Models.TMmemberList>

@{
    ViewData["Title"] = "客戶列表";
}
@section Styles {
    <style>
        .modal-dialog-scrollable .modal-body {
            max-height: 600px; 
        }
    </style>
}
<div class="container">
    <div>
        <h1>客戶列表</h1>
        <p>
            <!-- Button trigger modal -->
            <a asp-action="Create" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal"><i class="fa-sharp fa-solid fa-user-plus"></i> 建立新客戶  </a>

            <!-- Modal -->
            <div class="modal fade " id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered  modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="createModalLabel">建立新客戶</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body pb-5" id="modal-body-content">
                            <!-- Create form will be loaded here dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </p>
    </div>

    <table class="table table-primary table-striped table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.MemberName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MemberGender)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MemberPhone)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MemberEmail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MemberAddress)
                </th>
                @* <th> *@
                @*     @Html.DisplayNameFor(model => model.MemberPassword) *@
                @* </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.UrgentContact)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UrgentPhone)
                </th>
                @* <th> *@
                @*     @Html.DisplayNameFor(model => model.MemberPhoto) *@
                @* </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.RecentLogin)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.MemberName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MemberGender)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MemberPhone)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MemberEmail)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MemberAddress)
                    </td>
                    @* <td> *@
                    @*     @Html.DisplayFor(modelItem => item.MemberPassword) *@
                    @* </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.UrgentContact)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UrgentPhone)
                    </td>
                    @* <td> *@
                    @*     @Html.DisplayFor(modelItem => item.MemberPhoto) *@
                    @* </td> *@
                    <td>
                        @Html.DisplayFor(modelItem => item.RecentLogin)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MemberId" class="text-primary">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.MemberId" class="text-primary">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.MemberId" class="text-primary">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
	</table>
</div>

@section Scripts {
    <script>
        var myModal = new bootstrap.Modal(document.getElementById('createModal'),  {
            backdrop: false
        })
        $('#createModal').on('show.bs.modal', function (e) {
            var modal = $(this);
            $.ajax({
                url: '@Url.Action("Create")',  
                method: 'GET',
                success: function (data) {
                    modal.find('#modal-body-content').html(data); 
                },
                error: function () {
                    alert('無法載入創建頁面');
                }
            });
        });
    </script>
}
