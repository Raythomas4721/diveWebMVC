@model diveWebMVC.Models.TMmemberList

@{
	ViewData["Title"] = "建立新客戶";
}

<div class="container">


	<h2>建立新客戶</h2>

	@* <h4>TMmemberList</h4> *@
	<hr />
	<div class="row">
		<div class="col-md-4">
			<form asp-action="Create d-flex flex-column">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<div class="form-group">
					<label asp-for="MemberName" class="control-label"></label>
					<input asp-for="MemberName" class="form-control" />
					<span asp-validation-for="MemberName" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberGender" class="control-label"></label>
					@* <input asp-for="MemberGender" class="form-control" /> *@
					<select asp-for="MemberGender" class="form-control">
						<option value="男">男</option>
						<option value="女">女</option>
						<option value="不適用">不適用</option>
					</select>
					<span asp-validation-for="MemberGender" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberPhone" class="control-label"></label>
					<input asp-for="MemberPhone" class="form-control" />
					<span asp-validation-for="MemberPhone" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberEmail" class="control-label"></label>
					<input asp-for="MemberEmail" class="form-control" />
					<span asp-validation-for="MemberEmail" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberAddress" class="control-label"></label>
					<input asp-for="MemberAddress" class="form-control" />
					<span asp-validation-for="MemberAddress" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberPassword" class="control-label"></label>
					<input asp-for="MemberPassword" class="form-control" />
					<span asp-validation-for="MemberPassword" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="UrgentContact" class="control-label"></label>
					<input asp-for="UrgentContact" class="form-control" />
					<span asp-validation-for="UrgentContact" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="UrgentPhone" class="control-label"></label>
					<input asp-for="UrgentPhone" class="form-control" />
					<span asp-validation-for="UrgentPhone" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="MemberPhoto" class="control-label"></label>
					@* <input asp-for="MemberPhoto" class="form-control" /> *@
					<span asp-validation-for="MemberPhoto" class="text-danger"></span>
				</div>
				@* <div class="form-group"> *@
				@* 	<label asp-for="RecentLogin" class="control-label"></label> *@
				@* 	<input asp-for="RecentLogin" class="form-control" /> *@
				@* 	<span asp-validation-for="RecentLogin" class="text-danger"></span> *@
				@* </div> *@
				<div class="form-group d-flex align-items-center justify-content-between mt-3">
					<input type="submit" value="Create" class="btn btn-success" />
					<a asp-action="Index">Back to List</a>
				</div>
			</form>
		</div>
	</div>

	<div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
