@model IEnumerable<diveWebMVC.Models.TNorder>

@{
    ViewData["Title"] = "Index";
}

<div class="container">
<h3>商品列表</h3>
<p>
    <a asp-action="Create" class="btn btn-secondary"><i class="fa-solid fa-water fa-spin fa-spin-reverse"></i>新增商品訂單</a>
</p>
</div>
<table class=" table table-bordered table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>
                會員編號
                @* @Html.DisplayNameFor(model => model.Member) *@
            </th>
            <th>
                送貨地址
                @* @Html.DisplayNameFor(model => model.Address) *@
            </th>
            <th>
                訂單日期
                @* @Html.DisplayNameFor(model => model.OrderDate) *@
            </th>
            <th>
                訂單狀態
                @* @Html.DisplayNameFor(model => model.OrderStatus) *@
            </th>
            <th>
                付款狀態
                @* @Html.DisplayNameFor(model => model.PaymentStatus) *@
            </th>
            <th>
                總金額
                @* @Html.DisplayNameFor(model => model.TotalAmount) *@
            </th>
            <th>
                創建日期
                @* @Html.DisplayNameFor(model => model.CreatedDate) *@
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Member.MemberId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.OrderId">Details</a> |
                    <a class="btn btn-secondary" asp-action="Delete" asp-route-id="@item.OrderId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
