@model diveWebMVC.Models.TCcourse

@{
    ViewData["Title"] = "Delete";
}

@section Styles
{
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />@*asp-append-version版本號，可不加(去問AI)*@
}




<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2 class="text-center">課程詳情</h2>
            <dl class="row">
                <!-- 課程種類 -->
                <dt class="col-sm-3 h4">
                    課程種類
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.CourseCategory.CategoryName)
                </dd>

                <!-- 課程程度 -->
                <dt class="col-sm-3 h4">
                    課程程度
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.Level.LevelName)
                </dd>

                <!-- 課程教練 -->
                <dt class="col-sm-3 h4">
                    課程教練
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.Coach.CoachName)
                </dd>

                <!-- 課程價格 -->
                <dt class="col-sm-3 h4">
                    課程價格
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.CoursePrice)
                </dd>

                <!-- 課程照片 -->
                <dt class="col-sm-3 h4">
                    課程照片
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    <partial name="_ShowPhotoPartial" />
                </dd>

                <!-- 創建日期 -->
                <dt class="col-sm-3 h4">
                    創建日期
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.CreatedAt)
                </dd>

                <!-- 更新日期 -->
                <dt class="col-sm-3 h4">
                    更新日期
                </dt>
                <dd class="col-sm-9 h4" style="font-weight: normal">
                    @Html.DisplayFor(model => model.UpdatedAt)
                </dd>
            </dl>

            <!-- 編輯和返回列表 -->
            <div class="text-center mb-3">
                <a asp-action="Edit" asp-route-id="@Model?.CourseId" class="btn btn-primary">編輯課程</a>
            </div>

            <!-- 返回列表 -->
            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-secondary btn-block">返回列表</a>
            </div>
        </div>
    </div>
</div>
