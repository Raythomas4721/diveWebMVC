<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2>新增課程</h2>
            <form asp-action="Create">
                <!-- 表單驗證訊息 -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- 課程分類 -->
                <div class="form-group">
                    <label asp-for="CourseCategoryId" class="control-label">課程分類</label>
                    <select asp-for="CourseCategoryId" class="form-control" asp-items="ViewBag.CourseCategoryId"></select>
                </div>

                <!-- 課程等級 -->
                <div class="form-group">
                    <label asp-for="LevelId" class="control-label">課程等級</label>
                    <select asp-for="LevelId" class="form-control" asp-items="ViewBag.LevelId"></select>
                </div>

                <!-- 教練 -->
                <div class="form-group">
                    <label asp-for="CoachId" class="control-label">教練</label>
                    <select asp-for="CoachId" class="form-control" asp-items="ViewBag.CoachId"></select>
                </div>

                <!-- 課程價格 -->
                <div class="form-group">
                    <label asp-for="CoursePrice" class="control-label">課程價格</label>
                    <input asp-for="CoursePrice" class="form-control" />
                    <span asp-validation-for="CoursePrice" class="text-danger"></span>
                </div>

                <!-- 課程照片 -->
                <div class="form-group">
                    <label asp-for="Photo" class="control-label">課程照片</label>
                    <input asp-for="Photo" class="form-control" />
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>

                <!-- 創建日期 -->
                <div class="form-group">
                    <label asp-for="CreatedAt" class="control-label">創建日期</label>
                    <input asp-for="CreatedAt" class="form-control" />
                    <span asp-validation-for="CreatedAt" class="text-danger"></span>
                </div>

                <!-- 更新日期 -->
                <div class="form-group">
                    <label asp-for="UpdatedAt" class="control-label">更新日期</label>
                    <input asp-for="UpdatedAt" class="form-control" />
                    <span asp-validation-for="UpdatedAt" class="text-danger"></span>
                </div>

                <!-- 提交按鈕 -->
                <div class="form-group">
                    <input type="submit" value="新增" class="btn btn-primary btn-block" />
                </div>
            </form>

            <!-- 返回按鈕 -->
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary btn-block">返回列表</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
