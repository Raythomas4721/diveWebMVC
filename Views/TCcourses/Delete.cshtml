@model diveWebMVC.Models.TCcourse

@{
    ViewData["Title"] = "Delete";
}

@section Styles
{
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />
}



<div class="container col-md-6 offset-md-3">
    <dl class="row">
        
        <h2 class="text-center">刪除課程</h2>
        <dt class="col-sm-3 h4">
            課程名稱
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.CourseCategory.CategoryName)
        </dd>

        <dt class="col-sm-3 h4">
            課程程度
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.Level.LevelName)
        </dd>

        <dt class="col-sm-3 h4">
            課程教練
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.Coach.CoachName)
        </dd>

        <dt class="col-sm-3 h4">
            課程價格
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.CoursePrice)
        </dd>

        <dt class="col-sm-3 h4">
            課程照片
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            <partial name="_ShowPhotoPartial" />
        </dd>

        <dt class="col-sm-3 h4">
            建立時間
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>

        <dt class="col-sm-3 h4">
            更新時間
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.UpdatedAt)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseId" />
        <div class="text-center">
            <button type="submit" class="btn btn-danger" onclick="return confirm('是否確定刪除?')" class="text-center mb-3">
                <i class="fa-regular fa-trash-can fa-fade"></i> 刪除
            </button>
        </div>

        <div class="mt-3 text-center">
            <a asp-action="Index" class="btn btn-secondary btn-block class=" text-center mb-3"">返回列表</a>
        </div>
    </form>
</div>
