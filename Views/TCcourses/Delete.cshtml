@model diveWebMVC.Models.TCcourse

@{
    ViewData["Title"] = "Delete";
}
@section Styles
{
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />@*asp-append-version版本號，可不加(去問AI)*@
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TCcourse</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CoursePrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CoursePrice)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Photo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Photo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UpdatedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UpdatedAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Coach)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Coach.CoachId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CourseCategory)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CourseCategory.CourseCategoryId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Level)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Level.LevelId)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseId" />
        <button type="submit" onclick="return confirm('是否確定刪除?')" value="Delete" class="btn btn-danger"><i class="fa-regular fa-trash-can fa-fade"></i> 刪除</button>       
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary btn-block">Back to List</a>
        </div>
        @* <a asp-action="Index">Back to List</a> *@
    </form>
</div>
