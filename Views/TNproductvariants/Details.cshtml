@model diveWebMVC.Models.TNproductvariant

@{
    ViewData["Title"] = "Details";
}
<div class="container">
<h5>產品選項</h5>

<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
                商品
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Product.ProductName)
        </dd>
        <dt class = "col-sm-2">
                顏色
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Color.Color)
        </dd>
        <dt class = "col-sm-2">
                性別款式
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Gender.Gender)
        </dd>
        <dt class = "col-sm-2">
                尺寸
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Size.Size)
        </dd>
        <dt class = "col-sm-2">
                厚度
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Thickness.Thickness)
        </dd>
        <dt class = "col-sm-2">
                商品單價
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class = "col-sm-2">
                進貨量
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>
    </dl>
</div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ProductvariantsId">Edit</a> |
    <a style="color:darkslateblue" asp-action="Index">回庫存列表</a>
</div>
