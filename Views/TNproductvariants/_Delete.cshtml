@model diveWebMVC.Models.TNproductvariant
@{
    ViewData["Title"] = "Delete";
}
@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

}
<div class="container" mt-4>
   
    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4">
                庫存編號
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Product.ProductName)
                </dd>
                <dt class="col-sm-4">
                顏色
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Color.Color)
                </dd>
                <dt class="col-sm-4">
                尺寸
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Size.Size)
                </dd>
                <dt class="col-sm-4">
                厚度
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Thickness.Thickness)
                </dd>
                <dt class="col-sm-4">
                性別款式
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Gender.Gender)
                </dd>
                <dt class="col-sm-4">
                商品單價
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.UnitPrice)
                </dd>
                <dt class="col-sm-4">
                進貨量
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Stock)
                </dd>
            </dl>
    </div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductvariantsId" />
        
        <button id="confirmDelete" type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎?');">
            <i class="fa-light fa-trash-can fa-beat-fade"></i>刪除 |
        </button>
    </form>
    <a style="color:darkslateblue" asp-action="Index">回庫存列表</a>
    
</div>
   
