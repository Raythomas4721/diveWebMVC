@model diveWebMVC.Models.TNproductvariant
@{
    ViewData["Title"] = "Delete";
}
@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

}
<div class="container">

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>TNproductvariant</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
                商品
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Product.ProductName)
        </dd>
        <dt class = "col-sm-2">
                顏色
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Color.Color)
        </dd>
        <dt class = "col-sm-2">
                性別款式
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Gender.Gender)
        </dd>
        <dt class = "col-sm-2">
                尺寸
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Size.Size)
        </dd>
        <dt class = "col-sm-2">
                厚度
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Thickness.Thickness)
        </dd>
        <dt class = "col-sm-2">
                商品單價
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class = "col-sm-2">
                進貨量
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>
    </dl>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductvariantsId" />
            <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎?');">
                <i class="fa-light fa-trash-can fa-beat-fade"></i>刪除 |
            </button>
        <a asp-action="Index">Back to List</a>
    </form>
</div>
