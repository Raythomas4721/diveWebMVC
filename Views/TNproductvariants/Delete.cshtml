@model diveWebMVC.Models.TNproductvariant
@{
    ViewData["Title"] = "Delete";
}
@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

}
<div class="container" mt-4>

    <h5>確認要刪除此項目嗎?</h5>

    <hr />
    <div class="row">
        <div class="col-md-4">
            <dl class="row">
                <dt class="col-sm-4">
                    <strong>
                商品
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Product.ProductName)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                顏色
                        </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Color.Color)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                性別款式
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Gender.Gender)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                尺寸
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Size.Size)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                厚度
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Thickness.Thickness)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                商品單價
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.UnitPrice)
                </dd>
                <dt class="col-sm-4">
                    <strong>
                進貨量
                    </strong>
                </dt>
                <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Stock)
                </dd>
            </dl>
    </div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductvariantsId" />
        <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎?');">
            <i class="fa-light fa-trash-can fa-beat-fade"></i>刪除 |
        </button>
    </form>
    <a asp-action="Index">回庫存列表</a>
</div>
   
