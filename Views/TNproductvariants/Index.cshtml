@model IEnumerable<diveWebMVC.Models.TNproductvariant>

@{
    ViewData["Title"] = "Index";
}


<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered table-hover table-striped" style="width:100%">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Product)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Color)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thickness)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Product.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Color.Color)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Size.Size)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thickness.Thickness)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductvariantsId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductvariantsId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductvariantsId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
