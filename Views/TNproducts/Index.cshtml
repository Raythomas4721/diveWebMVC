@model IEnumerable<diveWebMVC.Models.TNproduct>

@{
    ViewData["Title"] = "Index";

}
@section Styles {
  
   @*  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"> *@
   <style>
       
        .modal-backdrop {
            z-index: 1040 !important; /* 背景遮罩層的 z-index */
            pointer-events: none;
        }

        .modal {
            z-index: 1050 !important; /* modal 本身的 z-index */
        }

        .modal-content {
            z-index: 1060 !important;
        }
        .custom-modal .modal-dialog{
        width: 90% !important; /* 設定寬度為 90% */
        max-width: 2000px !important; /* 設定最大寬度為 1500px */
        height: 90% !important; /* 設定高度 */
        margin: 50px auto !important; /* 讓 Modal 垂直居中 */
        
        }
    </style>
 
}


@* <div id="result" style="text-align: left;"></div> *@
<div class="container">
    <div>
        <h3>商品列表</h3>
        <div class="container d-flex justify-content-between align-items-center">
            <a asp-action="Create" class="btn btn-secondary"><i class="fa-solid fa-water fa-spin fa-spin-reverse"></i>新增商品</a>
            <div class="d-flex flex-column ms-auto" style="width: 30%;">
        <label class="form-label">篩選商品關鍵字:</label>
        <form method="post" asp-action="Index" asp-controller="TNproducts">
            <input id="searchString" name="searchString" class="form-control" type="text" placeholder="請輸入篩選關鍵字" value="@ViewBag.CurrentFilter" />
                    <button value="Search" class="btn btn-secondary ms-2"><i class="fa-light fa-magnifying-glass-plus"></i>搜尋</button>
        </form>
    </div>
    </div>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th style="width: 17%;">
                        @Html.DisplayNameFor(model => model.ProductName)
                </th>
                <th style="width: 15%;">
                        @Html.DisplayNameFor(model => model.UnitCost)
                </th >
                <th style="width: 20%;">
                        @Html.DisplayNameFor(model => model.Description)
                </th>
                <th style="width: 30%;">
                        @Html.DisplayNameFor(model => model.Picture)
                </th>
                <th style="width: 18%;">操作</th>
            </tr>
        </thead>
        <tbody id="productTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width: 17%;">
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td style="width: 15%;">
                        @Html.DisplayFor(modelItem => item.UnitCost)
                    </td>
                    <td style="width: 20%;">
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td style="width: 30%;">

                        <partial name="_ShowPicturePartial" model="@item" />
                    </td>
                    <td style="width: 18%">
                        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@item.ProductId">編輯</a>|
                        
                        <button class="btn btn-secondary" asp-action="Details" asp-route-id="@item.ProductId" onclick="showdetail(@item.ProductId)">檢視</button>|
                        
                        <a class="btn btn-secondary" asp-action="Delete" asp-route-id="@item.ProductId">刪除</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered  modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">商品資訊</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="result" style="text-align: left;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                @* <button type="button" class="btn btn-primary">Save changes</button> *@
            </div>
        </div>
    </div>
</div>
@section Scripts
{
  @*   <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
 *@
    <script>
          var myModal = new bootstrap.Modal(document.getElementById('exampleModal'), {
          keyboard: false,
          backdrop: false
        });
         function showdetail(productId){
            // alert("greetAsync");
            $.ajax({
            type:"GET",
             url:`https://localhost:7077/TNproducts/Details?id=${productId}`
            }).done(data=>{
               $("#result").html(data);
                myModal.show();
            }).fail(err=>{
                alert(`error:${err.status}`);
                });
        }

        
        </script>
}
