@model IEnumerable<diveWebMVC.Models.TNproduct>

@{
    ViewData["Title"] = "Index";
    
}
@section Styles {
    <style>
        

    </style>

}





<div class="container">
<div id="result" style="text-align: left;"></div>
    <span>
    <a asp-action="Create"><i class="fa-solid fa-water fa-spin fa-spin-reverse"></i>Create New</a>
</span>
<table class="table table-bordered table-hover table-striped" >
    <thead class="table-dark">
        <tr>
            <th>
                商品名稱
            </th>
            <th>
                進貨單價
            </th>
            <th>
                商品描述
            </th>
            <th>
                商品照片
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitCost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                    <partial name="_ShowPicturePartial" model="@item" />
            </td>
            <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                       <button class="btn btn-primary" asp-action="Details" asp-route-id="@item.ProductId" onclick="showdetail(@item.ProductId)">Details</button> |
                        <a class="btn btn-primary"  asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
@section Scripts
{

    <script>
       
         function showdetail(productId){
            
            // alert("greetAsync");
              $.ajax({
            type:"GET",
             url:`https://localhost:7077/TNproducts/Details?id=${productId}`
            }).done(data=>{
               $("#result").html(data);
             document.getElementById("result").scrollIntoView({ behavior: "smooth", block: "start" });
            }).fail(err=>{
                alert(`error:${err.status}`);
            });
        }

