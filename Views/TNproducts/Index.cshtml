@model IEnumerable<diveWebMVC.Models.TNproduct>

@{
    ViewData["Title"] = "Index";

}
@section Styles {
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .modal-backdrop {
            z-index: 1040 !important; /* 背景遮罩層的 z-index */
            pointer-events: none;
        }

        .modal {
            z-index: 1050 !important; /* modal 本身的 z-index */
        }

        .modal-content {
            z-index: 1060 !important;
        }
    </style>

}


@* <div id="result" style="text-align: left;"></div> *@
<div class="container">
    <div>
        <h1>商品列表</h1>
        <p>
        <a asp-action="Create"><i class="fa-solid fa-water fa-spin fa-spin-reverse"></i>新增商品</a>
    </p>
    </div>
    <div class="container" style="width:40%;margin-left:auto;margin-right:0px">
        <label class="form-label">篩選商品關鍵字:</label>
        <form method="post" asp-action="Index" asp-controller="TNproducts">
            <input id="searchString" name="searchString" class="form-control" type="text" placeholder="請輸入篩選關鍵字" value="@ViewBag.CurrentFilter" />
            <button value="Search" class="btn btn-primary"><i class="fa-light fa-magnifying-glass-plus"></i>搜尋</button>
        </form>
    </div>
    <table class="table table-bordered table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>
                        @Html.DisplayNameFor(model => model.ProductName)
                </th>
                <th>
                        @Html.DisplayNameFor(model => model.UnitCost)
                </th>
                <th>
                        @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                        @Html.DisplayNameFor(model => model.Picture)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody id="productTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UnitCost)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        <partial name="_ShowPicturePartial" model="@item" />
                    </td>
                    <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                        <button class="btn btn-primary" asp-action="Details" asp-route-id="@item.ProductId" onclick="showdetail(@item.ProductId)">Details</button> |
                        <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="result" style="text-align: left;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                @* <button type="button" class="btn btn-primary">Save changes</button> *@
            </div>
        </div>
    </div>
</div>
