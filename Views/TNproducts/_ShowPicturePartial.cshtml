@model diveWebMVC.Models.TNproduct
@inject diveShopperContext _context

@{
    // 如果你需要在 Partial 裡再次從資料庫查詢，可以這樣：
    // var product = await _context.TNproducts
    //     .Include(p => p.TNpictures)
    //     .FirstOrDefaultAsync(p => p.ProductId == Model.ProductId);

    // 但如果你的父頁面已經 Include 了 TNpictures（Model.TNpictures 不為空），
            // 則不必再次查詢，直接用 Model.TNpictures 即可。
}

@if (Model != null && Model.TNpictures != null && Model.TNpictures.Any())
{
    <!-- 多張圖片迭代 -->
    @foreach (var pic in Model.TNpictures)
    {
        <img style="width:280px;height:200px; margin-right:10px;"
             src="@Url.Action("GetPictureByPicId", "TNproducts", new { picId = pic.PictureId })"
             alt="商品圖片" />
    }
}
else
{
    <!-- 如果沒有任何圖片，就顯示預設圖 -->
    <img style="width:280px;height:200px;"
         src="~/images/noimage.png"
         alt="尚無圖片" />
}




