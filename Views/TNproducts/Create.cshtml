@model diveWebMVC.Models.TNproduct

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .container {
            margin-top: 50px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #f9f9f9;
            width: 80%; /* 设置表单宽度 */
        }
    </style>
}

@{
    ViewData["Title"] = "Create";
}

<div class="container" mt-4>
    <h5>新增商品</h5>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="ProductName" class="control-label">商品名稱</label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="UnitCost" class="control-label">進貨單價</label>
                    <input asp-for="UnitCost" class="form-control" />
                    <span asp-validation-for="UnitCost" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="control-label">商品描述</label>
                    <textarea asp-for="Description" cols="40" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                    <!-- 關鍵：要有 id="Picture" -->
                    @* <input type="file" id="Picture" name="Picture" class="form-control" /> *@
  
                <!-- 多圖 -->
                <div class="form-group">
                    <img id="imgPreview" class="img-fluid" src="@Url.Content("~/images/noimage.png")" title="尚無圖片" />
                    <label>更多照片(可多選)</label>
                    <input id="Picture" type="file" name="files" accept="image/*" class="form-control" multiple />
                    <span asp-validation-for="Picture" class="text-danger"></span>
                </div>
        <div class="form-group">
                <input id="submitBtn" type="submit" value="Create" class="btn btn-secondary" />
        </div>
                </form>
    </div>
</div>
</div>
    <div>
    <a style="color:darkslateblue" asp-action="Index">回商品列表</a>
    </div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // 1) 預覽單張主圖
        function previewImageFile(inputFile){
            if (inputFile.files && inputFile.files[0]) {
                var file = inputFile.files[0];
                // 驗證檔案類型
                var allowType = /image.*/;
                if (file.type.match(allowType)) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        // 直接指定 imgPreview
                        $("#imgPreview").attr("src", e.target.result);
                        $("#imgPreview").attr("title", file.name);
                    };
                    reader.readAsDataURL(file);
                    $('#submitBtn').prop("disabled", false); // 可送出
                } else {
                    alert("不支援上傳檔案格式");
                    inputFile.value = "";
                    $('#submitBtn').prop("disabled", true);
                }
            }
        }

        // 2) 當 #Picture 有變動時，呼叫預覽函式
        $("#Picture").on("change", function(){
            previewImageFile(this);
        });

        // 3) 防止重複送出表單 (可選)
        $("form").on("submit", function(){
            $("#submitBtn").prop("disabled", true);
        });
    </script>
}
