@model diveWebMVC.Models.TNproduct
@section Styles {

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .container {
            margin-top: 50px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #f9f9f9;
            width: 80%; /* 设置表单宽度 */
        }

    </style>
}

@{
    ViewData["Title"] = "Delete";
}
<br />
<div class="container" mt-4>
<h5>確認要刪除此項目嗎?</h5>
   
    <hr />
    <div class="row">
     <div class="col-md-4">
    <dl class="row">
                <dt class="col-sm-4">
                    <strong>
                        商品名稱
                    </strong>
        </dt>
        <dd class = "col-sm-8">
            @Html.DisplayFor(model => model.ProductName)
        </dd>
                <dt class="col-sm-4">
                    <strong>
                        進貨單價
                    </strong>
        </dt>
        <dd class = "col-sm-8">
            @Html.DisplayFor(model => model.UnitCost)
        </dd>
                <dt class="col-sm-4">
                    <strong>
                        商品描述
                    </strong>
        </dt>
        <dd class = "col-sm-8">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>

      <div class="row mt-3">
                <div class="col-md-4 text-end">
                        <h5>商品照片</h5>
                    </div>
                <div class="ml-3">
                    <partial name="_ShowPicturePartial" model="@Model" />
                    </div>
                </div>
            <div class="d-flex justify-content-between">
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductId" />
        <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎?');">
            <i class="fa-light fa-trash-can fa-beat-fade"></i>刪除 |</button>
    </form>
</div>
                <a style="color:darkslateblue" asp-action="Index">回商品列表</a>
        </div>
    </div>
</div>