@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/ag-grid-community/dist/ag-grid-community.min.noStyle.js"></script>


	<script>
			$(document).ready(function() {

			 $.ajax({
				type: 'GET',
				url: "https://localhost:7077/TMadmins/GetAdmin"
			})
			.done(function(data) {
				console.log(data);
				if (Array.isArray(data)) {
					var columnDefs = [
						{headerName: "使用者", field: "userName",width: 200 },
						{headerName: "電子郵件", field: "email",width: 200 },
						{headerName: "管理者權限", field: "roleName",width: 200 },
						{headerName: "建立日期", field: "createAt",width: 200 },
						{headerName: "最後登入", field: "lastLogin",width: 200  },
						{
							headerName: "操作",
							field: "actions",
							width: 300,
							cellRenderer: function(e) {
								const editUrl = `/TMadmins/Edit/${e.data.adminId}`;
								const deleteUrl = `/TMadmins/Delete/${e.data.adminId}`;
								return `
									<a class="btn btn-secondary" href="${editUrl}">Edit</a> |
									<a class="btn btn-danger"  href="${deleteUrl}">Delete</a>
								`;
							}
						}
					];
					const gridOptions = {
						columnDefs: columnDefs,
						rowData: data,
						defaultColDef: {
							sortable: false,
							filter: true,
						},
					};
				// 初始化 grid
				const myGridElement = document.querySelector('#myGrid');
				agGrid.createGrid(myGridElement, gridOptions);
				} else {
					console.error("Received data is not an array.");
				}
			})
			.fail(function(err) {
				alert("Error fetching data:", err);
			});
		})
	</script>
}