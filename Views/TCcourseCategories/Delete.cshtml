@model diveWebMVC.Models.TCcourseCategory

@{
    ViewData["Title"] = "Delete";
}

<div class="container col-md-6 offset-md-3">
    <h2 class="text-center">刪除課程種類</h2>
    <dl class="row">
        <dt class="col-sm-3 h4">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
        <dt class="col-sm-3 h4">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-3 h4">
            @Html.DisplayNameFor(model => model.Duration)
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.Duration)
        </dd>
        <dt class="col-sm-3 h4">
            @Html.DisplayNameFor(model => model.Quota)
        </dt>
        <dd class="col-sm-9 h4" style="font-weight: normal">
            @Html.DisplayFor(model => model.Quota)
        </dd>
    </dl>
    
    @* <form asp-action="Delete"> *@
    @*     <input type="hidden" asp-for="CourseCategoryId" /> *@
    @*     <input type="submit" value="Delete" class="btn btn-danger" /> | *@
    @*     <a asp-action="Index">Back to List</a> *@
    @* </form> *@

    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseCategoryId" />
        <div class="text-center">
            <button type="submit" class="btn btn-danger text-center mb-3" onclick="return confirm('是否確定刪除?')">
                <i class="fa-regular fa-trash-can fa-fade"></i> 刪除
            </button>
        </div>

        <div class="mt-3 text-center">
            <a asp-action="Index" class="btn btn-secondary btn-block text-center mb-3">返回列表</a>
        </div>
    </form>
</div>
